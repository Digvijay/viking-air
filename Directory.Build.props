<Project>

  <!--
    Without this file, Directory.TargetFrameworks.props was never imported: every project
    hardcoded net10.0, and the CI preview leg built net10.0 only and reported success. A check
    that cannot fail is not a check.
  -->
  <Import Project="Directory.TargetFrameworks.props" />

  <!--
    Versions of the four toolkit libraries this repository integrates.

    Each is overridable, and CI overrides all four: eng/build-libraries.ps1 builds the libraries
    from source, packs them into a local feed, and exports the resulting versions as environment
    variables, which MSBuild reads as properties. That is what makes this repository an
    integration test of the libraries' current source rather than of whatever was last published.

    The defaults are the next release of each library. Until those are published, a plain
    `dotnet restore` needs the local feed; run eng/build-libraries.ps1 first.
  -->
  <PropertyGroup>
    <AutoMappicVersion Condition="'$(AutoMappicVersion)' == ''">0.8.0</AutoMappicVersion>
    <RappVersion Condition="'$(RappVersion)' == ''">1.3.0</RappVersion>
    <SannrVersion Condition="'$(SannrVersion)' == ''">1.7.0</SannrVersion>
    <SkuggaVersion Condition="'$(SkuggaVersion)' == ''">1.6.0</SkuggaVersion>
  </PropertyGroup>

</Project>
