<Project Sdk="Aspire.AppHost.Sdk/13.1.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(ToolkitAppTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>60d4a851-bc5a-43a0-a8f1-3e296a261489</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- A library, not an orchestrated resource: reference it for its types only. -->
    <ProjectReference Include="..\VikingAir.ServiceDefaults\VikingAir.ServiceDefaults.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\VikingAir.Api\VikingAir.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.NodeJs" Version="9.5.2" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.1.0" />
    <!--
      Transitive via Aspire.Hosting.NodeJs. 2.5.192 carries eleven advisories, two of them high
      severity. Pinned to the latest patched 2.x rather than 3.x to avoid the 3.0 breaking changes.
    -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

</Project>
